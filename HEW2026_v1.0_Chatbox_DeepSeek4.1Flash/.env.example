# 秘密情報・接続情報はここに書き、.env は Git 管理しない。
SECRET_KEY=change-this-to-a-random-value

# SQLite（開発）: sqlite:///instance/hew.db
# MariaDB（XAMPP）: mysql+pymysql://hew_user:password@127.0.0.1:3306/hew?charset=utf8mb4
DATABASE_URL=sqlite:///instance/hew.db

# 保存先ディレクトリ（公開用 PNG と権限付き ZIP の両方を置く）
UPLOAD_ROOT=instance/uploads

# 上限制限（バイト）
MAX_COMPOSITE_PNG_BYTES=5242880
MAX_LAYER_PNG_BYTES=5242880
MAX_LAYER_TOTAL_BYTES=52428800

# 1 日開催のイベント終了時刻（UTC, ISO8601）。未設定なら制限なし。
# 例: EVENT_ENDS_AT=2026-11-20T06:00:00
EVENT_ENDS_AT=

# アプリ停止目安（終了の約 2 時間後）
APP_STOPS_AT=

# ボーナス（仮データ。将来再検討する）
BONUS_REGISTRATION_POINTS=1000
BONUS_FIRST_LISTING_POINTS=300
BONUS_DAILY_SAVE_POINTS=100
