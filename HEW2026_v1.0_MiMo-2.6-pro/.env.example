# Flask
SECRET_KEY=change-me
# 開発は SQLite（instance/ 配下に作成）、本番は MariaDB（PyMySQL）
# DATABASE_URL=sqlite:///hew_dev.db
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/hew
FLASK_DEBUG=1

# 1日開催のイベント終了日時（UTC ISO8601）。空なら無期限。
# EVENT_END_AT=2026-11-03T09:00:00+00:00

# 保存先と容量上限（MiB）
UPLOAD_FOLDER=app/static/uploads/artworks
MAX_PNG_MIB=5
MAX_LAYER_MIB=5
MAX_LAYERS_TOTAL_MIB=50
