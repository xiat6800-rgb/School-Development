# ========================================
# HEW Ver0.5 環境設定（キー名と例のみ。実値はコミットしない）
# ========================================

# Flask
FLASK_ENV=development
# 本番では必ず設定する。未設定の開発起動ではプロセスごとに自動生成する
SECRET_KEY=

# MariaDB / MySQL（XAMPP の場合は root、パスワードは各環境のもの）
# 例: mysql+pymysql://root:your-password@127.0.0.1:3306/hew?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/hew?charset=utf8mb4
# テスト専用DB（未設定時は一時 SQLite で実行）
TEST_DATABASE_URL=
SQL_ECHO=false

# アップロード（静的ディレクトリ外に保存する）
UPLOAD_FOLDER=app/uploads/artworks
MAX_IMAGE_BYTES=2097152
MAX_IMAGE_WIDTH=2048
MAX_IMAGE_HEIGHT=2048
CANVAS_WIDTH=800
CANVAS_HEIGHT=600

# オークション運用（要件定義書 9章の未決事項を環境設定で吸収する）
BID_INCREMENT=100
BONUS_SIGNUP_POINTS=1000
BONUS_FIRST_LISTING_POINTS=500
BONUS_DRAW_POINTS=100
BONUS_DRAW_MAX_TIMES=10

# メール通知（未設定なら notification_deliveries に pending で記録する）
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=no-reply@hew2026.local
